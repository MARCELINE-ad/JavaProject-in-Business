digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.4, dpi=150, size="8,8"];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=13, color="#2F5597", fillcolor="#EAF2F8", margin="0.16,0.10"];
edge [fontname="Times New Roman", fontsize=11, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить строку часов", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Разделить строку: split(\";\", -1)"];
n3 [label="Ровно пять значений?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="Для каждого элемента:\nпроверить ^0*[0-9]+$ и диапазон [0, 16],\nпреобразовать в int"];
n5 [label="Все элементы корректны?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Вычислить total, average,\novertimeDays и weeklyOvertime"];
n7 [label="Сформировать табель:\nПн, Вт, Ср, Чт, Пт", fillcolor="#DDEBF7"];
n8 [label="Сформировать итоговый вывод"];
n9 [label="Сформировать сообщение об ошибке", fillcolor="#FCE4D6", color="#C65911"];
start -> n1 -> n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n9 [label="нет"];
n4 -> n5;
n5 -> n6 [label="да"];
n5 -> n9 [label="нет"];
n6 -> n7 -> n8 -> end;
n9 -> end;
}
